# Register a GitHub OAuth App with /api/auth/callback/github as its callback.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Generate a separate random secret for production. Never commit it.
AUTH_SECRET=
AUTH_URL=http://localhost:4401
NEXT_PUBLIC_SITE_URL=http://localhost:4401
# A pooled PostgreSQL connection string from the Vercel Neon integration.
DATABASE_URL=
# Prefer the direct connection for the versioned database migration.
DATABASE_URL_UNPOOLED=

# Private, pre-generated audio only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
# Server-only sb_secret_ key (recommended) or legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
AUDIO_STORAGE_BUCKET=readlay-audio
# Optional local listening preview; ignored on Vercel.
AUDIO_STORAGE_MODE=supabase
# Optional private Cloudflare R2 for the larger catalogue. Keep old Supabase
# settings while existing publications still use that storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET=readlay-audio
